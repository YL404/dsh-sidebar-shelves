{
  "name": "dsh-sidebar-shelves",
  "version": "0.1.0",
  "type": "module",
  "description": "Two-line session cards for the DSH sidebar: per-workspace project icons, pinning, archiving, status markers, job counts, and recency sorting",
  "license": "MIT",
  "author": "Han (https://github.com/YL404)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YL404/dsh-sidebar-shelves.git"
  },
  "homepage": "https://github.com/YL404/dsh-sidebar-shelves#readme",
  "bugs": {
    "url": "https://github.com/YL404/dsh-sidebar-shelves/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "session-list"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
