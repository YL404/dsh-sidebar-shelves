{
  "name": "@local/dsh-sidebar-shelves",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two-line session cards for the dsh sidebar: per-workspace project icons (monogram, emoji, square image, or .icon package), pinning, manual or timed archiving, status markers, and recency sorting",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
